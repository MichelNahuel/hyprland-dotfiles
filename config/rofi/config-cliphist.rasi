/* -----------------------------------------------------
 * Historial del portapapeles (Super+V, via ml4w-cliphist). Entradas largas: panel ancho.
 * El aspecto es el compartido: rofi/estilo.rasi.
 * ----------------------------------------------------- */

configuration {
    font:            "JetBrainsMono Nerd Font Propo 10";
    show-icons:      false;
    hover-select:    false;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/estilo.rasi"

window   { width: 760px; }
listview { lines: 12; }
/* el script de ML4W no pasa -p, así que rofi muestra "dmenu": se oculta */
prompt   { enabled: false; }
entry    { placeholder: "buscar en el portapapeles"; }
