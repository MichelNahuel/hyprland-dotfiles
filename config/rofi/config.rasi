/* -----------------------------------------------------
 * Lanzador. El aspecto vive en estilo.rasi, compartido con
 * los demás menús de rofi. Reemplaza al config de ML4W.
 * ----------------------------------------------------- */

configuration {
    modi:                "drun,run,filebrowser,window";
    font:                "JetBrainsMono Nerd Font Propo 10";
    show-icons:          false;
    drun-display-format: "{name}";
    display-drun:        "›";
    display-run:         "$";
    display-window:      "□";
    display-filebrowser: "/";
    hover-select:        false;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    window-format:       "{c}  ·  {t}";
    /* lo que mejor coincide con lo escrito queda arriba (antes: historial y orden alfabético),
       y solo se busca en el nombre: los juegos de Steam coincidían por su comando "steam://…" */
    sort:                true;
    sorting-method:      "fzf";
    drun-match-fields:   "name,generic,keywords";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/estilo.rasi"

listview { lines: 8; }
entry    { placeholder: "buscar"; }
