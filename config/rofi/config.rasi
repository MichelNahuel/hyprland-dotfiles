/* -----------------------------------------------------
 * Lanzador. El aspecto vive en estilo.rasi, compartido con
 * los demás menús de rofi. Reemplaza al config de ML4W.
 * ----------------------------------------------------- */

configuration {
    modi:                "drun,run,filebrowser,window";
    font:                "JetBrainsMono Nerd Font Propo 10";
    show-icons:          false;
    drun-display-format: "{name}";
    display-drun:        "›";
    display-run:         "$";
    display-window:      "□";
    display-filebrowser: "/";
    hover-select:        false;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    window-format:       "{c}  ·  {t}";
}

@theme "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/estilo.rasi"

listview { lines: 8; }
entry    { placeholder: "buscar"; }
