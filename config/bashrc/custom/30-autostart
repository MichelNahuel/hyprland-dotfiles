# -----------------------------------------------------
# AUTOSTART (propia)
# Reemplaza a ~/.config/bashrc/30-autostart: el cargador de ML4W usa el archivo
# de custom/ cuando existe uno con el mismo nombre.
# Igual que el original, más el bloque animado "N · M ·" centrado.
# -----------------------------------------------------

# The 'finder' command (Fuzzy Finder)
finder() {
    # Run the script and capture the result
    local result=$($HOME/.config/ml4w/bin/ml4w-finder)

    # Check if the script told us to CD
    if [[ "$result" == TYPE_DIR:* ]]; then
        local target_dir="${result#TYPE_DIR:}"
        cd "$target_dir" && ls
    elif [[ "$result" == TYPE_FILE:* ]]; then
    # Check if we have a file
        ${EDITOR:-nano} "${result#TYPE_FILE:}"
    else
    # Return an error
        echo "Could not read $result" >&2
        return 1
    fi
}

# -----------------------------------------------------
# Fastfetch
# -----------------------------------------------------
if [[ $(tty) == *"pts"* ]]; then
    if [ ! -f $HOME/.config/ml4w/settings/hide-fastfetch ]; then
        fastfetch
        [ -x "$HOME/.config/fastfetch/centrado.sh" ] && "$HOME/.config/fastfetch/centrado.sh"
        # Al cambiar el tamaño de la ventana (o al abrir una pestaña, que también la
        # cambia) las imágenes quedan corridas: se vuelven a dibujar recentradas.
        # El propio script se abstiene si ya se scrolleó o hay comandos ejecutados.
        trap '[ -x "$HOME/.config/fastfetch/centrado.sh" ] && "$HOME/.config/fastfetch/centrado.sh"' WINCH
    fi
fi
